
<div class="contact-page">
    <section class="page-banner">
        <div class="container">
            <p class="section-subheading">Get In Touch</p>
            <h1 class="section-heading">Book A Show</h1>
            <div class="section-divider"></div>
            <p class="banner-description">Interested in having Lock-in' Ringers perform at your event? Fill out the form below and we'll get back to you shortly.</p>
        </div>
    </section>

    <section class="contact-section">
        <div class="container">
            <form class="contact-form">
                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Name</label>
                        <input id="name" type="text" placeholder="Your name">
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input id="email" type="email" placeholder="your@email.com">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="date">Performance Date(s)</label>
                        <input id="date" type="text" placeholder="e.g. June 14, 2025">
                    </div>
                    <div class="form-group">
                        <label for="location">Performance Location</label>
                        <input id="location" type="text" placeholder="City, Province">
                    </div>
                </div>
                <div class="form-group">
                    <label for="message">Message / Details</label>
                    <textarea id="message" rows="6" placeholder="Tell us about your event..."></textarea>
                </div>
                <div class="form-submit">
                    <button type="submit" class="btn btn-filled">Send Message</button>
                </div>
            </form>
        </div>
    </section>
</div>
